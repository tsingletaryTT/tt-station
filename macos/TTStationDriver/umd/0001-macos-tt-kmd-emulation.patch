new file mode 100644
index 00000000..789cf55a
--- /dev/null
+++ b/tt-umd-utils/src/robust_mutex_darwin.cpp
@@ -0,0 +1,182 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+// RobustMutex on macOS.
+//
+// The Linux implementation (robust_mutex.cpp) keeps a process-shared *robust* pthread mutex in POSIX
+// shared memory: if the holder dies, the next locker gets EOWNERDEAD and recovers it. macOS has no
+// robust mutexes (no PTHREAD_MUTEX_ROBUST, pthread_mutex_consistent or pthread_mutex_timedlock), so
+// this version uses flock(2) on a lock file instead. That gives the same guarantee by a different
+// route: the kernel drops a flock when the holding process exits or crashes, so a dead holder
+// never leaves the lock stuck.
+//
+// flock locks belong to an open file description, so two threads sharing one RobustMutex (one fd)
+// wouldn't exclude each other through flock alone. A process-wide timed mutex per lock name covers
+// threads; flock covers processes. The holder's PID is written into the file so probe_lock() can
+// report who holds it, as the Linux version does.
+//
+// The class layout is the shared header's: shm_fd_ holds the lock file, mutex_wrapper_ptr_ is unused.
+
+#include "tt-umd-utils/robust_mutex.hpp"
+
+#include <fcntl.h>
+#include <fmt/format.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <chrono>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <tt-logger/tt-logger.hpp>
+
+#include "tt-umd-utils/error.hpp"
+
+namespace tt::umd {
+
+pthread_mutex_t RobustMutex::multithread_mutex_ = PTHREAD_MUTEX_INITIALIZER;
+
+namespace {
+
+// One timed mutex per lock name, for the threads of this process.
+std::timed_mutex& thread_mutex_for(const std::string& name) {
+    static std::mutex registry_guard;
+    static std::map<std::string, std::unique_ptr<std::timed_mutex>> registry;
+    std::lock_guard<std::mutex> g(registry_guard);
+    auto& slot = registry[name];
+    if (!slot) {
+        slot = std::make_unique<std::timed_mutex>();
+    }
+    return *slot;
+}
+
+std::string lock_file_path(const std::string& name) {
+    std::string safe = name;
+    for (char& c : safe) {
+        if (c == '/') {
+            c = '_';
+        }
+    }
+    const char* tmp = getenv("TMPDIR");
+    std::string dir = tmp && *tmp ? tmp : "/tmp/";
+    if (dir.back() != '/') {
+        dir += '/';
+    }
+    return dir + std::string(RobustMutex::SHM_FILE_PREFIX) + safe;
+}
+
+}  // namespace
+
+RobustMutex::RobustMutex(std::string_view mutex_name) : mutex_name_(mutex_name) {}
+
+RobustMutex::~RobustMutex() noexcept { close_mutex(); }
+
+RobustMutex::RobustMutex(RobustMutex&& other) noexcept :
+    shm_fd_(std::exchange(other.shm_fd_, -1)),
+    mutex_wrapper_ptr_(std::exchange(other.mutex_wrapper_ptr_, nullptr)),
+    mutex_name_(std::move(other.mutex_name_)),
+    active_locks_(other.active_locks_.load()) {}
+
+RobustMutex& RobustMutex::operator=(RobustMutex&& other) noexcept {
+    if (this != &other) {
+        close_mutex();
+        shm_fd_ = std::exchange(other.shm_fd_, -1);
+        mutex_wrapper_ptr_ = std::exchange(other.mutex_wrapper_ptr_, nullptr);
+        mutex_name_ = std::move(other.mutex_name_);
+        active_locks_.store(other.active_locks_.load());
+    }
+    return *this;
+}
+
+void RobustMutex::initialize() { open_shm_file(); }
+
+void RobustMutex::open_shm_file() {
+    const std::string path = lock_file_path(mutex_name_);
+    shm_fd_ = open(path.c_str(), O_RDWR | O_CREAT | O_CLOEXEC, 0666);
+    if (shm_fd_ == -1) {
+        UMD_THROW(error::RuntimeError, fmt::format("open({}) failed for mutex {} errno: {}", path, mutex_name_, errno));
+    }
+    fchmod(shm_fd_, 0666);  // shared between users, as the Linux shm files are (ALL_RW_PERMISSION)
+}
+
+// Unused on macOS: there is no shared-memory mutex to size, map or initialise.
+bool RobustMutex::resize_shm_file() { return false; }
+void RobustMutex::open_pthread_mutex() {}
+size_t RobustMutex::get_file_size(int) { return 0; }
+void RobustMutex::initialize_pthread_mutex_first_use() {}
+
+void RobustMutex::close_mutex() noexcept {
+    if (shm_fd_ != -1) {
+        close(shm_fd_);  // also releases any flock this descriptor still holds
+        shm_fd_ = -1;
+    }
+}
+
+void RobustMutex::record_acquisition() {
+    // Leave the holder's PID in the file for probe_lock() callers to report.
+    char buf[32];
+    int n = snprintf(buf, sizeof buf, "%d\n", static_cast<int>(getpid()));
+    if (ftruncate(shm_fd_, 0) == 0) {
+        (void)!pwrite(shm_fd_, buf, static_cast<size_t>(n), 0);
+    }
+    active_locks_.fetch_add(1, std::memory_order_relaxed);
+}
+
+void RobustMutex::unlock() {
+    active_locks_.fetch_sub(1, std::memory_order_relaxed);
+    (void)!ftruncate(shm_fd_, 0);
+    if (flock(shm_fd_, LOCK_UN) != 0) {
+        UMD_THROW(error::RuntimeError, fmt::format("flock(LOCK_UN) failed for mutex {} errno: {}", mutex_name_, errno));
+    }
+    thread_mutex_for(mutex_name_).unlock();
+}
+
+std::optional<std::pair<pid_t, pid_t>> RobustMutex::probe_lock(std::chrono::seconds timeout) {
+    using clock = std::chrono::steady_clock;
+    const auto deadline = clock::now() + timeout;
+    std::timed_mutex& tm = thread_mutex_for(mutex_name_);
+    if (!tm.try_lock_until(deadline)) {
+        return std::make_pair(getpid(), 0);  // held by another thread of this process
+    }
+    for (;;) {
+        if (flock(shm_fd_, LOCK_EX | LOCK_NB) == 0) {
+            record_acquisition();
+            return std::nullopt;
+        }
+        if (errno != EWOULDBLOCK && errno != EINTR) {
+            tm.unlock();
+            UMD_THROW(error::RuntimeError, fmt::format("flock() failed for mutex {} errno: {}", mutex_name_, errno));
+        }
+        if (clock::now() >= deadline) {
+            break;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    }
+    tm.unlock();
+    // Best-effort owner report: the PID the holder wrote. There is no portable TID; report 0.
+    char buf[32] = {0};
+    pid_t owner = 0;
+    if (pread(shm_fd_, buf, sizeof buf - 1, 0) > 0) {
+        owner = static_cast<pid_t>(atoi(buf));
+    }
+    return std::make_pair(owner, 0);
+}
+
+void RobustMutex::lock() {
+    if (auto owner = probe_lock(std::chrono::seconds(1))) {
+        log_warning(LogUMD, "Waiting for lock '{}' which is currently held by PID: {}", mutex_name_, owner->first);
+        thread_mutex_for(mutex_name_).lock();
+        if (flock(shm_fd_, LOCK_EX) != 0) {
+            thread_mutex_for(mutex_name_).unlock();
+            UMD_THROW(error::RuntimeError, fmt::format("flock(LOCK_EX) failed for mutex {} errno: {}", mutex_name_, errno));
+        }
+        record_acquisition();
+    }
+}
+
+}  // namespace tt::umd
