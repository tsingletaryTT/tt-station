@@ -0,0 +1,31 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+// Linux-only mmap/madvise flags, given their macOS meaning so the shared code compiles unchanged.
+//
+// macOS has no hugetlbfs, no MAP_HUGETLB/MAP_HUGE_* and no MAP_POPULATE. Defined as 0 they ask for
+// ordinary pages, which is all a Mac can give: the card reaches host memory through the DART (an
+// IOMMU), which maps 16 KiB pages to one contiguous device-visible range, so UMD's need for
+// physically contiguous hugepages doesn't apply. MADV_HUGEPAGE has no counterpart; callers skip it.
+#pragma once
+
+#include <sys/mman.h>
+
+#if defined(__APPLE__)
+#ifndef MAP_POPULATE
+#define MAP_POPULATE 0
+#endif
+#ifndef MAP_HUGETLB
+#define MAP_HUGETLB 0
+#endif
+#ifndef MAP_HUGE_1GB
+#define MAP_HUGE_1GB 0
+#endif
+#ifndef MAP_HUGE_512MB
+#define MAP_HUGE_512MB 0
+#endif
+#ifndef MAP_HUGE_2MB
+#define MAP_HUGE_2MB 0
+#endif
+#endif
