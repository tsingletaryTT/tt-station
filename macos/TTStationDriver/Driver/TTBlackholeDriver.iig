// TTBlackholeDriver.iig — the dext's main service.
//
// Matches a Tenstorrent Blackhole (1e52:b140) behind a Thunderbolt tunnel (see Info.plist),
// opens the IOPCIDevice, enables memory-space decoding, and registers itself so a user
// client can be opened against it. All actual device access happens in userspace through
// the BAR mappings TTBlackholeUserClient hands out.
//
// Adapted from tinygrad's TinyGPUDriver (MIT, tinygrad/tinygrad extra/usbgpu/tbgpu).
// .iig is DriverKit's interface definition language: the build's iig step turns this into
// TTBlackholeDriver.h plus the IPC glue. Methods marked LOCALONLY are plain in-process C++
// calls (used by our user client, which lives in the same dext process), not IPC messages.

#ifndef TTBlackholeDriver_h
#define TTBlackholeDriver_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/IOMemoryDescriptor.iig>
#include <PCIDriverKit/IOPCIDevice.iig>

class TTBlackholeDriver: public IOService
{
public:
    virtual bool init() override;
    virtual void free() override;

    virtual kern_return_t Start(IOService * provider) override;
    virtual kern_return_t Stop(IOService * provider) override;

    virtual kern_return_t NewUserClient(uint32_t type, IOUserClient ** userClient) override;

    // Size in bytes of `bar` as the PCI core assigned it; 0 if absent. Never fails loudly —
    // a missing BAR is information (spec risk R1), not an error.
    uint64_t BarSize(uint8_t bar) LOCALONLY;

    // Hand out the device memory backing `bar` for mapping into a client.
    kern_return_t CopyBarMemory(uint8_t bar, IOMemoryDescriptor ** memory) LOCALONLY;

    // Config-space read of `width` (1/2/4) bytes at `offset`.
    kern_return_t CfgRead(uint32_t offset, uint32_t width, uint32_t * value) LOCALONLY;
};

#endif /* TTBlackholeDriver_h */
