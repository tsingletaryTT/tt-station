<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  DEV entitlements — ad-hoc signing with SIP disabled only (scripts/install-dev.sh).
  Unlike TinyGPU's NoSIP set (which matches ANY PCI device) this stays scoped to
  Tenstorrent's vendor ID: even in dev we never want this dext claiming someone else's
  hardware. allow-any-userclient-access lets the unsigned probe open the service.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.driverkit</key>
	<true/>
	<key>com.apple.developer.driverkit.transport.pci</key>
	<array>
		<dict>
			<key>IOPCIPrimaryMatch</key>
			<string>0x00001e52&amp;0x0000FFFF</string>
		</dict>
	</array>
	<key>com.apple.developer.driverkit.allow-any-userclient-access</key>
	<true/>
</dict>
</plist>
