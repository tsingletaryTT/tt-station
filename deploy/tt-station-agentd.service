[Unit]
Description=tt-station box agent (QuietBox control plane)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart={{AGENT_BIN}}
# systemd --user services get a minimal PATH that omits ~/.local/bin and any
# virtualenv, so the agent couldn't find tt-smi (device-mesh detection) or the
# python3 that runs tt-inference-server's run.py. `tt-station console --install-service`
# bakes the operator's own PATH in here at install time so the service can serve.
Environment=PATH={{PATH_ENV}}
Restart=on-failure
RestartSec=2
# Stop/restart only the agent itself, not everything it spawned: a model
# download (`tt model pull`) or an in-flight `tt serve` keeps going across an
# agent restart (the agent re-adopts running pulls and the serving container at
# startup). The default, control-group, killed a 17 GB-in download on restart.
# The flip side is that anything else left in this cgroup outlives the agent
# and is logged as a "left-over process" at the next start, so the agent keeps
# long-lived helpers out of it: apps it opens on the desktop (Hermes, Chrome via
# gtk-launch/xdg-open) run in their own `systemd-run --user --scope`, and the
# tt-toplike behind a terminal WebSocket dies with the agent (PR_SET_PDEATHSIG).
# See crates/tt-station-agentd/src/scope.rs.
KillMode=process

[Install]
WantedBy=default.target
