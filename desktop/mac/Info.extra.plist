<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- macOS asks before an app talks to devices on the local network: this is what it says why. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>TT Station finds your Tenstorrent devices on your network and connects to them.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_tenstorrent._tcp</string>
  </array>
  <key>NSMicrophoneUsageDescription</key>
  <string>TT Station records meetings and voice questions with your microphone and sends them to your box to transcribe.</string>
  <!-- Electron's own Info.plist asks for these with generic wording ("This app needs
       access to…"). TT Station uses none of them; these replace that wording, and
       keep macOS from closing the app if a page ever asks. -->
  <key>NSAudioCaptureUsageDescription</key>
  <string>TT Station doesn't record other apps' sound.</string>
  <key>NSCameraUsageDescription</key>
  <string>TT Station doesn't use the camera.</string>
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>TT Station doesn't use Bluetooth.</string>
  <key>NSBluetoothPeripheralUsageDescription</key>
  <string>TT Station doesn't use Bluetooth.</string>
  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
</dict>
</plist>
