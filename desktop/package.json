{
  "name": "tt-station",
  "productName": "TT Station",
  "version": "0.1.0",
  "description": "The QuietBox 2's own desktop app: run, watch and connect everything on the box.",
  "private": true,
  "license": "Apache-2.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "start": "electron . --ozone-platform-hint=auto",
    "test": "vitest run && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@shikijs/langs": "^4.5.0",
    "@tenstorrent/vesper": "^0.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "jsdom": "30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "5.0.3"
  },
  "desktopName": "tt-station.desktop"
}
