<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>aps-environment</key>
    <string>development</string>
    <!-- The app's own group first (where its box tokens stay), then the one it
         shares with the notification service extension (PushCredentials). -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.tenstorrent.ttstation.mobile</string>
        <string>$(AppIdentifierPrefix)com.tenstorrent.ttstation.shared</string>
    </array>
</dict>
</plist>
