"""Fake `tt-orchard`: `bringup` walks four stages, `status --json` prints the run's state, and
pause/resume/abort write the control file, like the real one."""
import json
import os
import signal
import sys
import time
from pathlib import Path

CHECKOUT = Path(os.path.realpath(__file__)).parent.parent
ROOT = Path(json.loads((CHECKOUT / "config" / "bringup.json").read_text())["runs_root"])


def arg(name):
    return sys.argv[sys.argv.index(name) + 1]


def write(run, status):
    tmp = run / "status.tmp"
    tmp.write_text(json.dumps(status))
    tmp.rename(run / "status.json")
    with open(run / "ledger.jsonl", "a") as f:
        f.write(json.dumps({"state": status["state"]}) + "\n")


def control(run):
    path = run / "control"
    if path.exists():
        word = path.read_text().strip()
        path.unlink()
        return word
    return None


def bringup(model):
    print(f"preflight for {model}", flush=True)
    if model.startswith("refuse/"):
        time.sleep(1.0)
        print("refused: model-unavailable", flush=True)
        return 2
    run = ROOT / model.lower().replace("/", "--")
    run.mkdir(parents=True, exist_ok=True)
    tick = 1.0 if "slow" in model else 0.3
    if "stuck" in model:
        # Like a real supervisor waiting on a coder boot: it never reads the
        # control file, and stops cleanly only on SIGTERM.
        status = {"model": model, "state": "running", "supervisor": {"alive": True, "pid": os.getpid()},
                  "stage": {}, "stages": [], "blocked": None, "pause": None, "hint": "", "counts": {},
                  "disk": {}, "last_events": [{"ts": time.time(), "event": "run_start"}]}
        write(run, status)

        def on_term(signum, frame):
            status.update(state="aborted", supervisor={"alive": False})
            write(run, status)
            sys.exit(4)

        signal.signal(signal.SIGTERM, on_term)
        while True:
            time.sleep(0.1)
    status = {"model": model, "state": "running", "supervisor": {"alive": True, "pid": os.getpid()},
              "stage": {"current": 0}, "stages": [], "blocked": None, "pause": None, "hint": "wait",
              "counts": {}, "disk": {}, "last_events": [{"ts": time.time(), "event": "run_start"}]}
    write(run, status)
    for n, name in [(0, "intake"), (1, "reference"), (2, "functional"), (8, "bundle")]:
        status["stage"] = {"current": n, "name": name}
        status["stages"].append({"stage": n, "name": name, "status": "running", "wall_s": 0})
        write(run, status)
        waited = 0.0
        while waited < tick:
            word = control(run)
            if word == "abort":
                status.update(state="aborted", supervisor={"alive": False})
                write(run, status)
                return 4
            if word == "pause":
                status["state"] = "paused"
                write(run, status)
                while control(run) != "resume":
                    time.sleep(0.05)
                status["state"] = "running"
                write(run, status)
            time.sleep(0.05)
            waited += 0.05
        status["stages"][-1].update(status="pass", wall_s=120.0)
        write(run, status)
    bundle = run / "stages" / "8" / "bundle"
    bundle.mkdir(parents=True, exist_ok=True)
    (bundle / "RESULTS.md").write_text(f"# {model}\n\nfake results\n")
    status.update(state="ready-for-operator-review", supervisor={"alive": False})
    write(run, status)
    print("ripe", flush=True)
    return 0


def main():
    cmd = sys.argv[1]
    if cmd == "bringup":
        return bringup(sys.argv[2])
    run = Path(arg("--run-dir"))
    if cmd == "status":
        print((run / "status.json").read_text())
        return 0
    (run / "control").write_text(cmd)
    return 0


sys.exit(main())
